{
  "name": "Unifying Firmware (nRF Connect SDK)",
  "image": "docker.io/nordicplayground/nrfconnect-sdk:v2.9-branch",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "nordic-semiconductor.nrf-connect",
        "nordic-semiconductor.nrf-terminal",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.watcherExclude": {
          "**/ncs/**": true,
          "**/.west/**": true,
          "**/build/**": true,
          "/workdir/**": true
        }
      }
    }
  },
  "forwardPorts": [],
  "onCreateCommand": "echo 'Preparing nRF Connect SDK Codespace...'",
  "remoteEnv": {
    "NCS_VERSION": "v3.4.0",
    "NCS_DIR": "/root/ncs/v3.4.0",
    "NRFUTIL_HOME": "/usr/local/share/nrfutil"
  },
  "containerEnv": {
    "NCS_VERSION": "v3.4.0",
    "NCS_DIR": "/root/ncs/v3.4.0",
    "NRFUTIL_HOME": "/usr/local/share/nrfutil"
  }
}
